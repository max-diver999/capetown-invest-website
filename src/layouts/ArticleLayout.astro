---
import BaseLayout from './BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import FaqBlock from '../components/FaqBlock.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { SITE } from '../data/site';
import { resolveRelatedSlugs, resolveRelatedEntities, type GraphCollection } from '../lib/content-graph';
import { heroCloudinary, responsiveCloudinary } from '../lib/cloudinary';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  readingTime?: number;
  heroImage?: string;
  heroAlt?: string;
  heroCredit?: {
    author: string;
    authorUrl?: string;
    licence: string;
    licenceUrl: string;
    sourceUrl: string;
  };
  faq?: { question: string; answer: string }[];
  canonical?: string;
  noindex?: boolean;
  hasInlineFaqBlock?: boolean;
  contextLabel?: string;
  collection?: GraphCollection;
  entryId?: string;
  relatedSlugs?: string[];
  articleType?: 'Article' | 'NewsArticle';
  extraSchemas?: object[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = SITE.editorial,
  readingTime = 8,
  heroImage,
  heroAlt,
  heroCredit,
  faq = [],
  canonical,
  noindex = false,
  hasInlineFaqBlock = false,
  contextLabel = title,
  collection,
  entryId,
  relatedSlugs = [],
  articleType = 'Article',
  extraSchemas = [],
} = Astro.props;

const dateStr = (updatedDate || pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const pageUrl = canonical || Astro.url.href;

const SECTION_LABELS: Record<string, string> = {
  guides: 'Guides',
  areas: 'Areas',
  projects: 'Projects',
  compare: 'Comparisons',
  segments: 'Buyer guides',
  developers: 'Developers',
  news: 'News',
};

const pathParts = Astro.url.pathname.split('/').filter(Boolean);
const sectionSlug = collection ?? pathParts[0];
const sectionName = SECTION_LABELS[sectionSlug] ?? (sectionSlug ? sectionSlug[0].toUpperCase() + sectionSlug.slice(1) : '');

/** One array feeds both the visible trail and BreadcrumbList, so they cannot drift. */
const crumbs = [
  { name: 'Home', href: '/' },
  ...(sectionSlug ? [{ name: sectionName, href: `/${sectionSlug}/` }] : []),
  { name: title, href: pageUrl },
];

const curated = collection && entryId ? await resolveRelatedSlugs(relatedSlugs, entryId) : [];
const entities = collection && entryId ? await resolveRelatedEntities(collection, entryId, 4) : [];
const entityLinks = entities.filter((e) => !curated.some((c) => c.href === e.href)).slice(0, 4);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': articleType,
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/og-default.png` },
  },
  mainEntityOfPage: pageUrl,
  ...(heroImage ? { image: heroImage } : {}),
};

const faqSchema = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.name,
    item: crumb.href.startsWith('http') ? crumb.href : `${SITE.url}${crumb.href}`,
  })),
};

const schemas = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : []), ...extraSchemas];
const resolvedHeroAlt = heroAlt || `${title} — Cape Town property research`;
const cloudinaryHero = heroImage ? heroCloudinary(heroImage) : null;
const inlineHero = heroImage && !cloudinaryHero ? responsiveCloudinary(heroImage) : null;
---
<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogImage={heroImage}
  type="article"
  preloadImage={cloudinaryHero?.narrow.src}
  preloadImageSrcset={cloudinaryHero?.narrow.srcset}
  preloadImageSizes={cloudinaryHero?.sizes}
  {noindex}
  {schemas}
>
  <article class="site-container py-10 md:py-14">
    <Breadcrumbs items={crumbs} class="mb-6" />

    <header class="max-w-3xl mb-8">
      <span class="badge-pill mb-4">Research guide</span>
      <h1 class="mb-4 text-3xl md:text-4xl">{title}</h1>
      <p class="text-lg text-[var(--color-muted)] mb-4">{description}</p>
      <p class="text-sm text-[var(--color-muted)]">
        By {author} · Updated {dateStr} · {readingTime} min read
      </p>
    </header>

    {cloudinaryHero && (
      <figure class="article-hero-figure">
        <picture>
          <source
            media="(min-width: 900px)"
            srcset={cloudinaryHero.wide.srcset}
            sizes={cloudinaryHero.sizes}
          />
          <img
            src={cloudinaryHero.narrow.src}
            srcset={cloudinaryHero.narrow.srcset}
            sizes={cloudinaryHero.sizes}
            alt={resolvedHeroAlt}
            class="article-hero"
            style={`--hero-ar-narrow:${cloudinaryHero.narrowRatio};--hero-ar-wide:${cloudinaryHero.wideRatio};`}
            loading="eager"
            fetchpriority="high"
            width={cloudinaryHero.width}
            height={cloudinaryHero.height}
            data-hero-img
          />
        </picture>
        {heroCredit && (
          <figcaption class="article-hero-credit">
            Photo <a href={heroCredit.authorUrl ?? heroCredit.sourceUrl} rel="noopener nofollow" target="_blank">{heroCredit.author}</a>,
            <a href={heroCredit.licenceUrl} rel="license noopener nofollow" target="_blank">{heroCredit.licence}</a>,
            via <a href={heroCredit.sourceUrl} rel="noopener nofollow" target="_blank">Wikimedia Commons</a>
          </figcaption>
        )}
      </figure>
    )}

    {inlineHero && (
      <figure class="article-hero-figure">
      <img
        src={inlineHero.src}
        srcset={inlineHero.srcset}
        sizes={inlineHero.sizes}
        alt={resolvedHeroAlt}
        width={inlineHero.width || 1280}
        height={inlineHero.height || 720}
        class="article-hero"
        loading="eager"
        fetchpriority="high"
        data-hero-img
      />
      {heroCredit && (
        <figcaption class="article-hero-credit">
          Photo <a href={heroCredit.authorUrl ?? heroCredit.sourceUrl} rel="noopener nofollow" target="_blank">{heroCredit.author}</a>,
          <a href={heroCredit.licenceUrl} rel="license noopener nofollow" target="_blank">{heroCredit.licence}</a>,
          via <a href={heroCredit.sourceUrl} rel="noopener nofollow" target="_blank">Wikimedia Commons</a>
        </figcaption>
      )}
      </figure>
    )}

    <div class="prose">
      <slot />
    </div>

    {!hasInlineFaqBlock && faq.length > 0 && (
      <div class="max-w-3xl mt-10">
        <FaqBlock items={faq} />
      </div>
    )}

    <RelatedLinks items={curated} heading="Related research" />
    {entityLinks.length > 0 && (
      <RelatedLinks
        items={entityLinks}
        heading="Explore this market"
        intro="Areas, developments and developer profiles connected to this page."
      />
    )}

    <div class="max-w-3xl mt-12">
      <LeadForm
        title="Get a Cape Town property shortlist"
        subtitle="Share your budget, target area (Atlantic Seaboard, City Bowl, Winelands), and goal. We reply within one business day with matched stock and next steps."
        context={contextLabel}
      />
    </div>

    <aside class="max-w-3xl mt-10 surface-card p-5 text-sm text-[var(--color-muted)]">
      <strong>Disclaimer:</strong> Cape Town Invest is an independent editorial resource. We are not a developer or licensed broker.
      Enquiries may be referred to licensed South African property professionals. Transfer duty, exchange control, and visa rules change — verify with your conveyancer and immigration adviser before any transaction.
    </aside>
  </article>
</BaseLayout>

<script>
  /*
   * A hero that 404s used to leave a full-width dead band. Removing the element
   * lets the page close up instead of framing a missing image.
   */
  document.querySelectorAll('img[data-hero-img]').forEach((img) => {
    img.addEventListener('error', () => img.remove(), { once: true });
  });
</script>

<style>
  /* Square, unframed, and wide — the photograph is a stratum, not a framed plate. */
  .article-hero-figure { position: relative; margin: 0 0 2.5rem; }
  .article-hero {
    display: block;
    width: 100%;
    height: 22rem;
    object-fit: cover;
    border: 0;
    border-radius: 0;
  }
  @media (max-width: 640px) {
    .article-hero { height: 13rem; }
  }
  /* Licence condition, so it is never hidden at small widths. */
  .article-hero-credit {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.35rem 0.7rem;
    background: var(--color-deep);
    color: #b9c6cc;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    line-height: 1.5;
  }
  .article-hero-credit a { color: #f2efe8; text-decoration: underline; }
</style>
