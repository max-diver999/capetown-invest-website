---
import globalStyles from '../styles/global.css?url';
import archivo400 from '@fontsource/archivo/files/archivo-latin-400-normal.woff2?url';
import sourceSerif400 from '@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import WhatsAppIntentTracker from '../components/WhatsAppIntentTracker.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import CurrencyEngine from '../components/CurrencyEngine.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schemas?: object[];
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

const {
  title,
  description = SITE.description,
  canonical = Astro.url.href,
  ogImage = `${SITE.url}/og-default.png`,
  type = 'website',
  noindex = false,
  schemas = [],
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,
} = Astro.props;

const BRAND_SUFFIX = ' | Cape Town Invest';
const fullTitle =
  title.includes('Cape Town Invest') || title.length + BRAND_SUFFIX.length > 60
    ? title
    : `${title}${BRAND_SUFFIX}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/og-default.png`, width: 1200, height: 630 },
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  areaServed: {
    '@type': 'City',
    name: 'Cape Town',
    containedInPlace: { '@type': 'AdministrativeArea', name: 'Western Cape' },
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE.email,
    contactType: 'customer service',
    availableLanguage: ['English'],
  },
  sameAs: [
    ...SITE.sameAs,
    ...(SITE.wikidataId ? [`https://www.wikidata.org/wiki/${SITE.wikidataId}`] : []),
  ],
};

const absoluteOg = ogImage?.startsWith('http') ? ogImage : `${SITE.url}${ogImage ?? '/og-default.png'}`;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'en',
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};

const allSchemas = [orgSchema, websiteSchema, ...schemas];
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#1e3a47" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex,nofollow" />
    : <meta name="robots" content="index,follow,max-image-preview:large" />}
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={absoluteOg} />
  <meta property="og:image:alt" content={`${title} — ${SITE.name}`} />
  <meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteOg} />
  <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png?v=3" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preload" href={archivo400} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={sourceSerif400} as="font" type="font/woff2" crossorigin />

  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
  <link rel="dns-prefetch" href="https://res.cloudinary.com" />
  <link rel="preconnect" href="https://upload.wikimedia.org" crossorigin />

  {preloadImage && (
    <link
      rel="preload"
      as="image"
      href={preloadImage}
      fetchpriority="high"
      {...(preloadImageSrcset ? { imagesrcset: preloadImageSrcset, imagesizes: preloadImageSizes } : {})}
    />
  )}

  <style is:inline>
    :root {
      --color-page: #e8e4dc;
      --color-surface: #f2efe8;
      --color-ink: #22303a;
      --color-muted: #4d5a62;
      --color-deep: #1e3a47;
      --color-accent: #35606d;
      --font-sans: 'Archivo', system-ui, -apple-system, sans-serif;
      --font-serif: 'Source Serif 4', Georgia, 'Times New Roman', serif;
      --font-mono: 'Space Mono', ui-monospace, 'SFMono-Regular', monospace;
    }
    html { -webkit-font-smoothing: antialiased; }
    body {
      margin: 0;
      background: var(--color-page);
      color: var(--color-muted);
      font-family: var(--font-sans);
      line-height: 1.65;
      font-size: 1rem;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }
    body > main { flex: 1 0 auto; }
    header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--color-deep);
      border-bottom: 1px solid #162c37;
    }
    h1 {
      font-family: var(--font-serif);
      color: var(--color-ink);
      font-weight: 400;
      line-height: 1.1;
    }
    .home-hero__photo {
      position: relative;
      overflow: hidden;
      max-height: 26rem;
    }
    .home-hero__photo img {
      display: block;
      width: 100%;
      height: 26rem;
      object-fit: cover;
      object-position: 50% 52%;
    }
    @media (max-width: 640px) {
      .home-hero__photo, .home-hero__photo img { height: 15rem; max-height: 15rem; }
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--color-accent);
      color: #f2efe8;
      font-weight: 600;
      border-radius: 2px;
      text-decoration: none;
    }
  </style>
  <link rel="stylesheet" href={globalStyles} />

  {allSchemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <WhatsAppFloat />
  <CurrencyEngine />
  <WhatsAppIntentTracker />
  <GoogleAnalytics />
</body>
</html>
