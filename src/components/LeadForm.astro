---
import { SITE } from '../data/site';

interface Props {
  title?: string;
  subtitle?: string;
  context?: string;
  submitLabel?: string;
}

const {
  title = 'Get your Cape Town property shortlist',
  subtitle = 'Share your budget and target area — we respond within one business day.',
  context = '',
  submitLabel = 'Request shortlist →',
} = Astro.props;

const waText = encodeURIComponent(
  'Hi, I need help with a property enquiry from Cape Town Invest.',
);
const waHref = `${SITE.whatsapp}?text=${waText}`;
/** Unique per instance so two forms on one page keep valid label/input pairs. */
const uid = `lf-${Math.random().toString(36).slice(2, 8)}`;
---
<section class="surface-card p-8 md:p-10" id="lead-form">
  <span class="badge-pill mb-3">Free · Independent advisory</span>
  <h2 class="text-2xl mb-1 text-[var(--color-ink)]">{title}</h2>
  <p class="text-[var(--color-muted)] mb-5 text-sm">{subtitle}</p>

  <form class="grid gap-4 ig-lead-form" data-context={context} novalidate>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-medium mb-1" for={`${uid}-name`}>Your name *</label>
        <input type="text" id={`${uid}-name`} name="name" required placeholder="John Smith" autocomplete="name" />
      </div>
      <div>
        <label class="block text-xs font-medium mb-1" for={`${uid}-phone`}>WhatsApp / Phone *</label>
        <input type="tel" id={`${uid}-phone`} name="phone" required placeholder="+44 7700 900123" autocomplete="tel" />
      </div>
    </div>
    <div>
      <label class="block text-xs font-medium mb-1" for={`${uid}-email`}>Email</label>
      <input type="email" id={`${uid}-email`} name="email" placeholder="john@example.com" autocomplete="email" />
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-medium mb-1" for={`${uid}-market`}>Target area</label>
        <select id={`${uid}-market`} name="market">
          <option value="">— Select —</option>
          <option value="atlantic-seaboard">Atlantic Seaboard (Sea Point, Camps Bay, Clifton)</option>
          <option value="city-bowl">City Bowl / Waterfront</option>
          <option value="southern-suburbs">Southern Suburbs</option>
          <option value="century-city">Century City / Blouberg</option>
          <option value="winelands">Winelands / Stellenbosch</option>
          <option value="not-sure">Not sure yet</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium mb-1" for={`${uid}-budget`}>Budget (ZAR, all-in)</label>
        <select id={`${uid}-budget`} name="budget">
          <option value="">— Select —</option>
          <option value="under-3m">Under R3M</option>
          <option value="3-5m">R3M – R5M</option>
          <option value="5-10m">R5M – R10M</option>
          <option value="10-20m">R10M – R20M</option>
          <option value="20m+">R20M+</option>
        </select>
      </div>
    </div>
    <div>
      <label class="block text-xs font-medium mb-1" for={`${uid}-goal`}>Your goal</label>
      <select id={`${uid}-goal`} name="goal">
        <option value="">— Select —</option>
        <option value="investment">Rental yield / investment</option>
        <option value="own-stay">Own stay / relocation / semigration</option>
        <option value="holiday-home">Holiday home</option>
        <option value="off-plan">New development / off-plan</option>
        <option value="explore">Just researching</option>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium mb-1" for={`${uid}-message`}>Message (optional)</label>
      <textarea id={`${uid}-message`} name="message" rows="3" placeholder="E.g. 2-bed Sea Point apartment, foreign buyer, budget R4M all-in including transfer duty…"></textarea>
    </div>
    <div class="lead-form-consent">
      <input type="checkbox" id={`${uid}-consent`} name="consent" required class="lead-form-consent__check" />
      <label class="lead-form-consent__label" for={`${uid}-consent`}>I agree to be contacted about my enquiry. See our <a href="/privacy-policy/">Privacy Policy</a>.</label>
    </div>
    <div class="lf-hp" aria-hidden="true">
      <label for={`${uid}-website`}>Company website</label>
      <input type="text" tabindex="-1" autocomplete="off" id={`${uid}-website`} name="website" />
    </div>
    <p data-lf-error role="alert" class="hidden lf-status lf-status--err text-sm text-center">Something went wrong. Email {SITE.email} or{' '}
      <a
        href={SITE.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-placement="inline_cta"
        data-cta="whatsapp_form_error"
      >
        WhatsApp us
      </a>.</p>
    <button type="submit" class="btn-primary w-full py-3">{submitLabel}</button>

    <p class="text-center text-sm text-[var(--color-muted)]">
      Prefer WhatsApp?
      <a
        href={waHref}
        class="font-semibold underline hover:no-underline"
        target="_blank"
        rel="noopener noreferrer"
        data-wa-placement="inline_cta"
        data-cta="whatsapp_lead_form"
      >
        Message us on WhatsApp
      </a>
    </p>
    <p data-lf-success class="hidden lf-status lf-status--ok text-sm font-semibold text-center">Thank you — redirecting…</p>
  </form>
</section>

<style>
  /* Status colours carry meaning, so they stay separate from the accent — but they are palette-tuned, not Tailwind defaults. */
  .lf-status--ok { color: #1f5d3a; }
  .lf-status--err { color: #8f2f26; }

  .lf-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  import { track } from '../lib/track';

  function pageIdentity() {
    const parts = window.location.pathname.split('/').filter(Boolean);
    return {
      collection: parts.length > 1 ? parts[0] : 'root',
      slug: parts.length > 0 ? parts[parts.length - 1] : 'home',
    };
  }

  document.querySelectorAll<HTMLFormElement>('form.ig-lead-form').forEach((form) => {
    const formLoadedAt = Date.now();
    const successEl = form.querySelector<HTMLElement>('[data-lf-success]');
    const errorEl = form.querySelector<HTMLElement>('[data-lf-error]');
    let started = false;

    // A real field, not any focusin: the consent label carries a privacy link.
    form.querySelectorAll('input:not([tabindex="-1"]), select, textarea').forEach((field) => {
      field.addEventListener(
        'focus',
        () => {
          if (started) return;
          started = true;
          const { collection, slug } = pageIdentity();
          track('form_start', {
            form_context: form.dataset.context || '',
            form_location: 'article',
            page_path: window.location.pathname,
            collection,
            slug,
          });
        },
        { once: true },
      );
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const phone = String(fd.get('phone') || '');
      const email = String(fd.get('email') || '');
      const digits = phone.replace(/\D/g, '');
      const { collection, slug } = pageIdentity();

      /* A rejected submit used to return in silence, so the gap between a
       * form_start and a submission could not be read. */
      const fail = (reason: string, message: string) => {
        if (errorEl) {
          errorEl.textContent = message;
          errorEl.classList.remove('hidden');
        }
        track('form_validation_error', {
          form_location: 'article',
          reason,
          page_path: window.location.pathname,
          collection,
          slug,
        });
      };

      if (digits.length < 8 && !email.includes('@')) {
        fail('no-contact', 'Please enter a phone number with at least 8 digits, or a valid email address.');
        return;
      }
      /* `novalidate` turns off the browser check, so the required consent box
       * was never enforced by anything. */
      if (!fd.get('consent')) {
        fail('no-consent', 'Please tick the box so we know we may reply to you.');
        return;
      }
      errorEl?.classList.add('hidden');

      const payload = {
        name: String(fd.get('name') || ''),
        contact: phone || email,
        email,
        phone,
        market: String(fd.get('market') || ''),
        budget: String(fd.get('budget') || ''),
        goal: String(fd.get('goal') || ''),
        message: String(fd.get('message') || ''),
        website: String(fd.get('website') || ''),
        formLoadedAt,
        formElapsedMs: Date.now() - formLoadedAt,
        source: form.dataset.context || 'lead-form',
        page: window.location.pathname,
      };

      track('form_submit_attempt', {
        form_location: 'article',
        market: payload.market || 'not_set',
        budget: payload.budget || 'not_set',
        page_path: window.location.pathname,
        collection,
        slug,
      });

      try {
        const res = await fetch('/api/lead/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        let accepted = true;
        if (res.ok) {
          try {
            const data = (await res.json()) as { accepted?: boolean };
            if (data.accepted === false) accepted = false;
          } catch {
            accepted = true;
          }
        }
        if (res.ok) {
          successEl?.classList.remove('hidden');
          errorEl?.classList.add('hidden');
          if (accepted) {
            try {
              const track = (window as Window & { capeTownTrack?: (n: string, p?: Record<string, string>) => void })
                .capeTownTrack;
              if (typeof track === 'function') {
                track('lead_submit', {
                  form_source: payload.source,
                  page_path: payload.page,
                  market: payload.market || '',
                  budget: payload.budget || '',
                  goal: payload.goal || '',
                });
              }
            } catch {
              /* analytics must not block redirect */
            }
            setTimeout(() => { window.location.href = '/thanks/?lead=1'; }, 800);
          } else {
            setTimeout(() => { window.location.href = '/thanks/'; }, 800);
          }
        } else {
          errorEl?.classList.remove('hidden');
        }
      } catch {
        errorEl?.classList.remove('hidden');
        track('form_submit_error', {
          form_location: 'article',
          page_path: window.location.pathname,
          collection,
          slug,
        });
      }
    });
  });
</script>
