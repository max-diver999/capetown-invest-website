---
interface Props {
  text: string;
  buttonText: string;
  buttonHref: string;
}

const { text, buttonText, buttonHref } = Astro.props;
---

<div class="inline-cta">
  <p class="inline-cta__text">{text}</p>
  <a href={buttonHref} class="inline-cta__button">{buttonText}</a>
</div>

<style>
  .inline-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    background: transparent;
    border: 0;
    border-top: 2px solid var(--color-ink);
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    padding: 1.25rem 0;
    margin: 2rem 0;
  }

  @media (min-width: 640px) {
    .inline-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .inline-cta__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-ink);
    flex: 1;
  }

  .inline-cta__button {
    display: inline-block;
    background: var(--color-deep);
    color: #f2efe8;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.7rem 1.25rem;
    border-radius: 0;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease;
    flex-shrink: 0;
  }

  .inline-cta__button:hover {
    background: var(--color-deep-2);
    color: #f2efe8;
  }
</style>
