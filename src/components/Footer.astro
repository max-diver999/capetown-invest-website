---
import { SITE } from '../data/site';
import { PRIMARY_NAV, UTILITY_NAV, PILLAR_GUIDES, LEGAL_NAV } from '../data/nav';
const year = new Date().getFullYear();
const waText = encodeURIComponent('Hi, I have a Cape Town property question.');
---
<footer class="mt-16 border-t border-[var(--color-border)] bg-[var(--color-ink)] text-[#d6d3d1]">
  <div class="site-container py-12 grid gap-8 md:grid-cols-4 text-sm">
    <div>
      <p class="text-lg font-semibold text-white mb-2">{SITE.name}</p>
      <p class="leading-relaxed">{SITE.tagline}</p>
      <p class="mt-4">
        <a href="/get-shortlist/" class="text-white font-medium no-underline hover:underline">Get a free shortlist →</a>
      </p>
      <p class="mt-2">
        <a
          href={`${SITE.whatsapp}?text=${waText}`}
          target="_blank"
          rel="noopener noreferrer"
          data-wa-placement="footer_contact"
          data-cta="whatsapp_footer"
          class="text-[#d6d3d1] no-underline hover:text-white"
        >WhatsApp</a>
      </p>
    </div>

    <div>
      <p class="font-semibold text-white mb-3">Explore</p>
      <ul class="space-y-2">
        {PRIMARY_NAV.map((item) => (
          <li><a href={item.href} class="text-[#d6d3d1] hover:text-white no-underline">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-semibold text-white mb-3">Start here</p>
      <ul class="space-y-2">
        {PILLAR_GUIDES.map((item) => (
          <li><a href={item.href} class="text-[#d6d3d1] hover:text-white no-underline">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-semibold text-white mb-3">Company</p>
      <ul class="space-y-2">
        {UTILITY_NAV.map((item) => (
          <li><a href={item.href} class="text-[#d6d3d1] hover:text-white no-underline">{item.label}</a></li>
        ))}
        {LEGAL_NAV.map((item) => (
          <li><a href={item.href} class="text-[#d6d3d1] hover:text-white no-underline">{item.label}</a></li>
        ))}
        <li><a href={`mailto:${SITE.email}`} class="text-[#d6d3d1] hover:text-white no-underline">{SITE.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="site-container py-4 border-t border-white/10 text-xs text-[#a8a29e]">
    © {year} {SITE.name}. Independent research — not financial or legal advice. Verify all figures with licensed professionals.
  </div>
</footer>
