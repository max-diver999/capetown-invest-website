---
import { SITE } from '../data/site';
import { PRIMARY_NAV, UTILITY_NAV, PILLAR_GUIDES, LEGAL_NAV } from '../data/nav';
const year = new Date().getFullYear();
const waText = encodeURIComponent('Hi, I have a Cape Town property question.');
---
<footer class="site-footer border-t-2 border-[var(--color-ink)] bg-[var(--color-deep)] text-[#b9c6cc]">
  <div class="site-container py-12 grid gap-8 md:grid-cols-4 text-sm">
    <div>
      <p class="text-lg font-bold text-[#f2efe8] mb-2">{SITE.name}</p>
      <p class="leading-relaxed">{SITE.tagline}</p>
      <p class="mt-4">
        <a href="/get-shortlist/" class="text-[#f2efe8] font-semibold no-underline hover:underline">Get a free shortlist →</a>
      </p>
      <p class="mt-2">
        <a
          href={`${SITE.whatsapp}?text=${waText}`}
          target="_blank"
          rel="noopener noreferrer"
          data-wa-placement="footer_contact"
          data-cta="whatsapp_footer"
          class="text-[#b9c6cc] no-underline hover:text-[#f2efe8]"
        >WhatsApp</a>
      </p>
    </div>

    <div>
      <p class="footer-heading mb-3">Explore</p>
      <ul class="space-y-2">
        {PRIMARY_NAV.map((item) => (
          <li><a href={item.href} class="text-[#b9c6cc] hover:text-[#f2efe8] no-underline">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="footer-heading mb-3">Start here</p>
      <ul class="space-y-2">
        {PILLAR_GUIDES.map((item) => (
          <li><a href={item.href} class="text-[#b9c6cc] hover:text-[#f2efe8] no-underline">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="footer-heading mb-3">Company</p>
      <ul class="space-y-2">
        {UTILITY_NAV.map((item) => (
          <li><a href={item.href} class="text-[#b9c6cc] hover:text-[#f2efe8] no-underline">{item.label}</a></li>
        ))}
        {LEGAL_NAV.map((item) => (
          <li><a href={item.href} class="text-[#b9c6cc] hover:text-[#f2efe8] no-underline">{item.label}</a></li>
        ))}
        <li><a href={`mailto:${SITE.email}`} class="text-[#b9c6cc] hover:text-[#f2efe8] no-underline">{SITE.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="site-container py-4 border-t border-[#f2efe8]/15 text-xs text-[#9fb0b7]">
    © {year} {SITE.name}. Independent research — not financial or legal advice. Verify all figures with licensed professionals.
  </div>
</footer>

<style>
  .site-footer { margin-top: 4rem; }
  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f2efe8;
  }
</style>
