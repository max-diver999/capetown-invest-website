---
/**
 * Compact lead capture placed inside the article body.
 *
 * The single LeadForm sits after the prose and the related blocks: measured at
 * 86 % of page depth, 18 screens down on a 375 px screen. Rendered after the
 * prose and relocated by the inline script below to sit between the first and
 * second H2.
 *
 * Area and email, with the honeypot and elapsed-time field the spam gate reads.
 * `generate_lead` stays on /thanks/, which this redirects to.
 */
interface Props {
  context?: string;
}

const { context = '' } = Astro.props;
---
<div class="inline-cta" data-inline-cta>
  <form class="inline-cta__form" id="ct-inline-lead-form" data-context={context} novalidate>
    <p class="inline-cta__lead">
      <strong>Want this priced for your budget?</strong>
      Tell us the area and where to reply. Independent research first, then 3 to 5 matched options with the numbers behind each one.
    </p>

    <div class="inline-cta__row">
      <div class="inline-cta__field">
        <label class="inline-cta__label" for="il-market">Target area</label>
        <select id="il-market" name="market">
          <option value="">— Select —</option>
          <option value="atlantic-seaboard">Atlantic Seaboard</option>
          <option value="city-bowl">City Bowl / Waterfront</option>
          <option value="southern-suburbs">Southern Suburbs</option>
          <option value="century-city">Century City / Blouberg</option>
          <option value="winelands">Winelands / Stellenbosch</option>
          <option value="not-sure">Not sure yet</option>
        </select>
      </div>
      <div class="inline-cta__field">
        <label class="inline-cta__label" for="il-email">Email</label>
        <input type="email" id="il-email" name="email" placeholder="john@example.com" autocomplete="email" />
      </div>
      <button type="submit" class="btn-primary inline-cta__btn">Request shortlist →</button>
    </div>

    <div aria-hidden="true" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;">
      <label for="il-website">Website (leave blank)</label>
      <input type="text" tabindex="-1" autocomplete="off" id="il-website" name="website" />
    </div>

    <p id="il-error" class="inline-cta__error hidden" role="alert"></p>

    <div class="lead-form-consent inline-cta__consent">
      <input type="checkbox" id="il-consent" name="consent" class="lead-form-consent__check" />
      <label class="lead-form-consent__label" for="il-consent">I agree to be contacted about my enquiry. See our <a href="/privacy-policy/">Privacy Policy</a>.</label>
    </div>

    <p id="il-success" class="inline-cta__success hidden">Thank you, redirecting…</p>
  </form>
</div>

<script is:inline>
  /*
   * Runs during parsing, immediately after the prose has been read, so the band
   * is in its final position before first paint.
   */
  (function relocateInlineCta() {
    var band = document.querySelector('[data-inline-cta]');
    var prose = document.querySelector('.prose');
    if (!band || !prose) return;
    var headings = prose.querySelectorAll(':scope > h2');
    if (headings.length < 3) return;
    var anchor = headings[1];
    var separator = anchor.previousElementSibling;
    prose.insertBefore(band, separator && separator.tagName === 'HR' ? separator : anchor);
  })();
</script>

<script>
  import { track } from '../lib/track';

  const form = document.getElementById('ct-inline-lead-form') as HTMLFormElement | null;
  if (form) {
    const formLoadedAt = Date.now();
    const errorEl = document.getElementById('il-error');
    let started = false;

    function pageIdentity() {
      const parts = window.location.pathname.split('/').filter(Boolean);
      return {
        collection: parts.length > 1 ? parts[0] : 'root',
        slug: parts.length > 0 ? parts[parts.length - 1] : 'home',
      };
    }

    form.querySelectorAll('input:not([tabindex="-1"]), select, textarea').forEach((field) => {
      field.addEventListener(
        'focus',
        () => {
          if (started) return;
          started = true;
          const { collection, slug } = pageIdentity();
          track('form_start', {
            form_context: form!.dataset.context || '',
            form_location: 'inline',
            page_path: window.location.pathname,
            collection,
            slug,
          });
        },
        { once: true },
      );
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email') || '');
      const { collection, slug } = pageIdentity();

      function reportInvalid(reason: string, message: string, focusId: string) {
        if (errorEl) {
          errorEl.textContent = message;
          errorEl.classList.remove('hidden');
        }
        (document.getElementById(focusId) as HTMLElement | null)?.focus();
        track('form_validation_error', {
          form_location: 'inline',
          reason,
          page_path: window.location.pathname,
          collection,
          slug,
        });
      }

      if (!email.includes('@') || !/.+@.+\..+/.test(email)) {
        reportInvalid('bad-email', 'Please leave an email address we can reply to.', 'il-email');
        return;
      }
      if (!fd.get('consent')) {
        reportInvalid('no-consent', 'Please tick the box so we know we may reply to you.', 'il-consent');
        return;
      }
      errorEl?.classList.add('hidden');

      const payload = {
        contact: email,
        email,
        market: String(fd.get('market') || ''),
        website: String(fd.get('website') || ''),
        formLoadedAt,
        formElapsedMs: Date.now() - formLoadedAt,
        source: form.dataset.context || 'inline-cta',
        page: window.location.pathname,
        collection,
        slug,
        formLocation: 'inline',
      };

      track('form_submit_attempt', {
        form_location: 'inline',
        market: payload.market || 'not_set',
        page_path: window.location.pathname,
        collection,
        slug,
      });

      try {
        const res = await fetch('/api/lead/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('fail');
        let accepted = true;
        try {
          const data = (await res.json()) as { accepted?: boolean };
          if (data.accepted === false) accepted = false;
        } catch {
          accepted = true;
        }
        document.getElementById('il-success')?.classList.remove('hidden');
        // A submission the spam gate declined is not a lead: reset in place
        // rather than sending the reader to the conversion page.
        if (!accepted) {
          form.reset();
          return;
        }
        setTimeout(() => window.location.assign('/thanks/?lead=1'), 400);
      } catch {
        if (errorEl) {
          errorEl.textContent = 'Something went wrong. Please try the full form at the end of this page.';
          errorEl.classList.remove('hidden');
        }
        track('form_submit_error', {
          form_location: 'inline',
          page_path: window.location.pathname,
          collection,
          slug,
        });
      }
    });
  }
</script>
