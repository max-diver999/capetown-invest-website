---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { SITE } from '../../data/site';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const hasInlineFaqBlock = entry.body?.includes('<FaqBlock') ?? false;

/** Property-entity schema so developments can surface as places, not just articles. */
const d = entry.data;
const residenceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ApartmentComplex',
  name: d.title,
  description: d.description,
  url: `${SITE.url}/projects/${entry.id}/`,
  ...(d.heroImage ? { image: d.heroImage } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: d.district ?? d.area ?? 'Cape Town',
    addressRegion: d.region ?? 'Western Cape',
    addressCountry: 'ZA',
  },
  ...(d.units ? { numberOfAccommodationUnits: d.units } : {}),
  ...(d.developer ? { provider: { '@type': 'Organization', name: d.developer } } : {}),
  ...(d.priceFromZAR
    ? {
        offers: {
          '@type': 'AggregateOffer',
          priceCurrency: 'ZAR',
          lowPrice: d.priceFromZAR,
          ...(d.priceToZAR ? { highPrice: d.priceToZAR } : {}),
        },
      }
    : {}),
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  readingTime,
  heroImage,
  heroAlt,
  heroCredit,
  faq,
  noindex,
  relatedSlugs,
} = entry.data;
---
<ArticleLayout
  {title}
  {description}
  {pubDate}
  {updatedDate}
  {author}
  readingTime={readingTime ?? 8}
  {heroImage}
  {heroAlt}
  {heroCredit}
  {faq}
  {noindex}
  {hasInlineFaqBlock}
  {relatedSlugs}
  collection="projects"
  entryId={entry.id}
  contextLabel={title}
  extraSchemas={[residenceSchema]}
  canonical={`${SITE.url}/projects/${entry.id}/`}
>
  <Content />
</ArticleLayout>
