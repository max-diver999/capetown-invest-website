---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';

const isLead = Astro.url.searchParams.get('lead') === '1';
---
<BaseLayout
  title="Thank You"
  description="Thank you for contacting Cape Town Invest."
  noindex={true}
>
  <section class="site-container py-20 max-w-xl text-center">
    <p class="text-4xl mb-4">✓</p>
    <h1 class="mb-4">{isLead ? 'Request received' : 'Thank you'}</h1>
    <p class="text-[var(--color-muted)] mb-8">
      {isLead
        ? 'We received your shortlist request. Expect a reply by email or WhatsApp within one business day.'
        : `Thanks for visiting ${SITE.name}.`}
    </p>
    <a href="/guides/" class="btn-primary px-6 py-3">Browse guides</a>
  </section>
  {/* This was an is:inline script inside `{isLead && …}`. `isLead` reads
      Astro.url.searchParams, which is empty when a static page is prerendered,
      so the script was never emitted: the live page contained no conversion at
      all. It is unconditional now, checks `?lead=1` in the browser, and reports
      through `track`, which queues until GoogleAnalytics.astro defines gtag
      three seconds after load. */}
  <script>
    import { track } from '../../lib/track';

    if (new URLSearchParams(window.location.search).get('lead') === '1') {
      track('generate_lead', { lead_type: 'shortlist_form', value: 1, currency: 'ZAR' });
    }
  </script>
</BaseLayout>
