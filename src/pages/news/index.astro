---
export const prerender = true;
import { getCollection } from 'astro:content';
import HubLayout, { type HubGroup } from '../../layouts/HubLayout.astro';

const articles = (await getCollection('news'))
  .filter((n) => !n.data.noindex)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateLabel = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

const groups: HubGroup[] = [
  {
    label: 'Market updates',
    note: 'What moved in the Western Cape market and what it means for a buyer underwriting a deal now.',
    cards: articles.map((n) => ({
      href: `/news/${n.id}/`,
      title: n.data.title,
      description: n.data.description,
      image: n.data.heroImage,
      badges: ['Market update'],
      meta: dateLabel(n.data.updatedDate ?? n.data.pubDate),
    })),
  },
];
---
<HubLayout
  title="Cape Town Property Market News 2026"
  description="Cape Town and Western Cape property market updates for foreign buyers: price records, interest rates, foreign buyer flows and the Waterfront development pipeline."
  h1="Market news"
  intro={`Dated market notes with the investor implication spelled out, not press releases. Figures come from named sources and should be re-verified before you transact. For the underlying data series, see the <a href="/guides/cape-town-property-market-data-lightstone/">Lightstone market data guide</a> and the <a href="/guides/cape-town-property-market-forecast-2026-2027/">2026 to 2027 forecast</a>.`}
  sectionSlug="news"
  sectionName="News"
  groups={groups}
  total={articles.length}
  updatedLabel="August 2026"
/>
